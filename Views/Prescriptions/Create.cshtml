@model Prescription
@{ ViewData["Title"] = "New Prescription"; }
<h2>Issue Prescription</h2>
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="AppointmentID" />
    <input type="hidden" asp-for="PatientID" />
    <input type="hidden" asp-for="DoctorID" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">Medicines</label>
            <textarea asp-for="Medicines" class="form-control" placeholder="e.g. Paracetamol 500mg, Amoxicillin 250mg"></textarea>
        </div>
        <div class="col-12">
            <label class="form-label">Dosage Instructions</label>
            <textarea asp-for="Dosage" class="form-control" placeholder="e.g. 1 tablet 3x daily after meals for 5 days"></textarea>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="Appointments" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
