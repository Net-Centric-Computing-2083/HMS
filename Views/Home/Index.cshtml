@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12
        ? "Good morning"
        : hour < 17
            ? "Good afternoon"
            : "Good evening";

    var today = DateTime.Today.ToString("dddd, d MMMM yyyy");
}

<!-- Dashboard Header -->
<div class="dashboard-header mb-4">
    <div>
        <div class="dashboard-greeting">
            <span class="dashboard-label">HOSPITAL MANAGEMENT SYSTEM</span>
            <h1>@greeting</h1>
            <p class="dashboard-date">@today</p>
        </div>
    </div>

    <div class="dashboard-header-action">
        <a asp-controller="Appointments"
           asp-action="Create"
           class="btn btn-primary">
            <span class="me-1">+</span> New Appointment
        </a>
    </div>
</div>


<!-- Quick Actions -->
<div class="quick-actions mb-4">
    <div class="quick-action-title">
        <h2>Quick Actions</h2>
        <p>Frequently used hospital services</p>
    </div>

    <div class="quick-action-buttons">
        <a asp-controller="Patients"
           asp-action="Create"
           class="btn btn-primary btn-sm">
            + New Patient
        </a>

        <a asp-controller="Appointments"
           asp-action="Create"
           class="btn btn-outline-primary btn-sm">
            + New Appointment
        </a>

        <a asp-controller="Doctors"
           asp-action="Create"
           class="btn btn-outline-primary btn-sm">
            + New Doctor
        </a>
    </div>
</div>


<!-- Statistics -->
<div class="stat-strip mb-4">

    <!-- Total Patients -->
    <div class="stat-cell">
        <span class="stat-icon">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.6">
                <circle cx="12" cy="8" r="3.2" />
                <path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6" />
            </svg>
        </span>

        <span class="stat-value">
            @Model.TotalPatients
        </span>

        <span class="stat-label">
            Registered Patients
        </span>
    </div>


    <!-- Today's Appointments -->
    <div class="stat-cell">
        <span class="stat-icon">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.6">
                <rect x="4"
                      y="5.5"
                      width="16"
                      height="14.5"
                      rx="1.5" />
                <path d="M4 9.5h16M8 3.5v3M16 3.5v3" />
            </svg>
        </span>

        <span class="stat-value">
            @Model.TodaysAppointments.Count
        </span>

        <span class="stat-label">
            Appointments Today
        </span>
    </div>


    <!-- Active Doctors -->
    <div class="stat-cell">
        <span class="stat-icon">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.6">
                <path d="M6 20v-2a4 4 0 0 1 4-4h1" />
                <circle cx="10.5" cy="7.5" r="3" />
                <path d="M15 9.5c1.8-.6 3-.4 3.6.6.6 1-.2 2-1.6 2.3M14 13.2c1.8.3 3.4 1.6 3.4 3.6v1.7" />
            </svg>
        </span>

        <span class="stat-value">
            @Model.ActiveDoctors
        </span>

        <span class="stat-label">
            Active Doctors
        </span>
    </div>


    <!-- Outstanding Bills -->
    <div class="stat-cell @(Model.UnpaidBillsCount > 0 ? "is-alert" : "")">

        <span class="stat-icon">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.6">
                <path d="M7 4.5h10l1 15-6-2.5-6 2.5 1-15Z" />
                <path d="M9.5 9.5h5M9.5 12.5h5" />
            </svg>
        </span>

        <span class="stat-value">
            Rs. @Model.TotalOutstanding.ToString("N0")
        </span>

        <span class="stat-label">
            Outstanding
            (@Model.UnpaidBillsCount unpaid)
        </span>
    </div>

</div>


<!-- Main Dashboard Content -->
<div class="dashboard-content">

    <!-- Hospital Services -->
    <section class="dashboard-section mb-5">

        <div class="section-heading mb-3">
            <div>
                <span class="section-label">SERVICES</span>
                <h2 class="h5 mb-1">Hospital Services</h2>
                <p class="text-muted mb-0">
                    Select a service to manage hospital records.
                </p>
            </div>
        </div>


        <div class="module-grid">

            <!-- Patients -->
            <a class="module-tile is-primary"
               asp-controller="Patients"
               asp-action="Index">

                <span class="tile-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5">
                        <circle cx="12" cy="8" r="3.2" />
                        <path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6" />
                    </svg>
                </span>

                <div class="tile-content">
                    <h3>Patients</h3>
                    <p>
                        Add, search, and update patient records.
                    </p>
                </div>

                <span class="tile-arrow">→</span>

            </a>


            <!-- Appointments -->
            <a class="module-tile is-primary"
               asp-controller="Appointments"
               asp-action="Index">

                <span class="tile-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5">
                        <rect x="4"
                              y="5.5"
                              width="16"
                              height="14.5"
                              rx="1.5" />
                        <path d="M4 9.5h16M8 3.5v3M16 3.5v3" />
                    </svg>
                </span>

                <div class="tile-content">
                    <h3>Appointments</h3>
                    <p>
                        Book and manage patient appointments.
                    </p>
                </div>

                <span class="tile-arrow">→</span>

            </a>


            <!-- Doctors -->
            <a class="module-tile is-secondary"
               asp-controller="Doctors"
               asp-action="Index">

                <span class="tile-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5">
                        <path d="M6 20v-2a4 4 0 0 1 4-4h1" />
                        <circle cx="10.5" cy="7.5" r="3" />
                        <path d="M15 9.5c1.8-.6 3-.4 3.6.6.6 1-.2 2-1.6 2.3M14 13.2c1.8.3 3.4 1.6 3.4 3.6v1.7" />
                    </svg>
                </span>

                <div class="tile-content">
                    <h3>Doctors</h3>
                    <p>
                        Manage doctor profiles and availability.
                    </p>
                </div>

                <span class="tile-arrow">→</span>

            </a>


            <!-- Billing -->
            <a class="module-tile is-secondary"
               asp-controller="Bills"
               asp-action="Index">

                <span class="tile-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5">
                        <path d="M7 4.5h10l1 15-6-2.5-6 2.5 1-15Z" />
                        <path d="M9.5 9.5h5M9.5 12.5h5" />
                    </svg>
                </span>

                <div class="tile-content">
                    <h3>Billing</h3>
                    <p>
                        Create bills and track patient payments.
                    </p>
                </div>

                <span class="tile-arrow">→</span>

            </a>


            <!-- Patient History -->
            <a class="module-tile is-secondary"
               asp-controller="Patients"
               asp-action="Index">

                <span class="tile-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5">
                        <circle cx="12" cy="12" r="8" />
                        <path d="M12 8v4l2.5 2.5" />
                    </svg>
                </span>

                <div class="tile-content">
                    <h3>Patient History</h3>
                    <p>
                        View diagnoses and prescription history.
                    </p>
                </div>

                <span class="tile-arrow">→</span>

            </a>

        </div>

    </section>


    <!-- Today's Schedule -->
    <section class="dashboard-section">

        <div class="section-heading mb-3">

            <div>
                <span class="section-label">SCHEDULE</span>

                <h2 class="h5 mb-1">
                    Today's Appointments
                </h2>

                <p class="text-muted mb-0">
                    View the appointments scheduled for today.
                </p>
            </div>

            <a asp-controller="Appointments"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                View All
            </a>

        </div>


        <div class="schedule-list">

            @if (!Model.TodaysAppointments.Any())
            {
                <div class="schedule-empty">

                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.5">
                            <rect x="4"
                                  y="5.5"
                                  width="16"
                                  height="14.5"
                                  rx="1.5" />
                            <path d="M4 9.5h16M8 3.5v3M16 3.5v3" />
                        </svg>
                    </div>

                    <div>
                        <strong>No appointments today</strong>
                        <p class="mb-0">
                            There are no appointments booked for today.
                        </p>
                    </div>

                    <a asp-controller="Appointments"
                       asp-action="Create"
                       class="btn btn-sm btn-primary">
                        Schedule Appointment
                    </a>

                </div>
            }
            else
            {
                @foreach (var appt in Model.TodaysAppointments
                    .OrderBy(a => a.AppointmentTime))
                {
                    <div class="schedule-row">

                        <div class="schedule-time">
                            @appt.AppointmentTime.ToString(@"hh\:mm")
                        </div>

                        <div class="schedule-detail">

                            <div class="who">
                                @appt.PatientName

                                <span class="what">
                                    with @appt.DoctorName
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(appt.Reason))
                            {
                                <div class="what">
                                    @appt.Reason
                                </div>
                            }

                        </div>

                        <span class="badge text-bg-light border">
                            @appt.Status
                        </span>

                    </div>
                }
            }

        </div>

    </section>

</div>


<!-- Dashboard Footer Information -->
<div class="dashboard-footer mt-4">

    <div>
        <strong>Hospital Management System</strong>
        <span class="text-muted">
            &nbsp; | &nbsp; Centralized hospital information dashboard
        </span>
    </div>

    <div class="text-muted">
        @DateTime.Now.ToString("hh:mm tt")
    </div>

</div>