@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}

<div class="dashboard-greeting">
    <h1>@greeting</h1>
    <p>@DateTime.Today.ToString("dddd, d MMMM yyyy")</p>
</div>

<div class="quick-actions">
    <a asp-controller="Patients" asp-action="Create" class="btn btn-primary btn-sm">New patient</a>
    <a asp-controller="Appointments" asp-action="Create" class="btn btn-outline-primary btn-sm">New appointment</a>
    <a asp-controller="Doctors" asp-action="Create" class="btn btn-outline-primary btn-sm">New doctor</a>
</div>

<div class="stat-strip">
    <div class="stat-cell">
        <span class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>
        </span>
        <span class="stat-value">@Model.TotalPatients</span>
        <span class="stat-label">Registered patients</span>
    </div>
    <div class="stat-cell">
        <span class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="5.5" width="16" height="14.5" rx="1.5"/><path d="M4 9.5h16M8 3.5v3M16 3.5v3"/></svg>
        </span>
        <span class="stat-value">@Model.TodaysAppointments.Count</span>
        <span class="stat-label">Appointments today</span>
    </div>
    <div class="stat-cell">
        <span class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 20v-2a4 4 0 0 1 4-4h1"/><circle cx="10.5" cy="7.5" r="3"/><path d="M15 9.5c1.8-.6 3-.4 3.6.6.6 1-.2 2-1.6 2.3M14 13.2c1.8.3 3.4 1.6 3.4 3.6v1.7"/></svg>
        </span>
        <span class="stat-value">@Model.ActiveDoctors</span>
        <span class="stat-label">Active doctors</span>
    </div>
    <div class="stat-cell @(Model.UnpaidBillsCount > 0 ? "is-alert" : "")">
        <span class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 4.5h10l1 15-6-2.5-6 2.5 1-15Z"/><path d="M9.5 9.5h5M9.5 12.5h5"/></svg>
        </span>
        <span class="stat-value">Rs. @Model.TotalOutstanding.ToString("N0")</span>
        <span class="stat-label">Outstanding (@Model.UnpaidBillsCount unpaid)</span>
    </div>
</div>

<h2 class="h5 mb-3">Go to</h2>
<div class="module-grid">
    <a class="module-tile is-primary" asp-controller="Patients" asp-action="Index">
        <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>
        </span>
        <h3>Patients</h3>
        <p>Add, search, and update patient records.</p>
    </a>
    <a class="module-tile is-primary" asp-controller="Appointments" asp-action="Index">
        <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5.5" width="16" height="14.5" rx="1.5"/><path d="M4 9.5h16M8 3.5v3M16 3.5v3"/></svg>
        </span>
        <h3>Appointments</h3>
        <p>Book and manage today's appointments.</p>
    </a>
    <a class="module-tile is-secondary" asp-controller="Doctors" asp-action="Index">
        <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 20v-2a4 4 0 0 1 4-4h1"/><circle cx="10.5" cy="7.5" r="3"/><path d="M15 9.5c1.8-.6 3-.4 3.6.6.6 1-.2 2-1.6 2.3M14 13.2c1.8.3 3.4 1.6 3.4 3.6v1.7"/></svg>
        </span>
        <h3>Doctors</h3>
        <p>Manage doctor profiles and availability.</p>
    </a>
    <a class="module-tile is-secondary" asp-controller="Bills" asp-action="Index">
        <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 4.5h10l1 15-6-2.5-6 2.5 1-15Z"/><path d="M9.5 9.5h5M9.5 12.5h5"/></svg>
        </span>
        <h3>Billing</h3>
        <p>Create bills and track payments.</p>
    </a>
    <a class="module-tile is-secondary" asp-controller="Patients" asp-action="Index">
        <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2.5"/></svg>
        </span>
        <h3>Patient history</h3>
        <p>View past diagnoses and prescriptions.</p>
    </a>
</div>

<h2 class="h5 mb-2">Today's schedule</h2>
<div class="schedule-list">
    @if (!Model.TodaysAppointments.Any())
    {
        <div class="schedule-empty">No appointments booked for today yet.</div>
    }
    else
    {
        @foreach (var appt in Model.TodaysAppointments.OrderBy(a => a.AppointmentTime))
        {
            <div class="schedule-row">
                <div class="schedule-time">@appt.AppointmentTime.ToString(@"hh\:mm")</div>
                <div class="schedule-detail">
                    <div class="who">@appt.PatientName <span class="what">with @appt.DoctorName</span></div>
                    @if (!string.IsNullOrWhiteSpace(appt.Reason))
                    {
                        <div class="what">@appt.Reason</div>
                    }
                </div>
                <span class="badge text-bg-light border">@appt.Status</span>
            </div>
        }
    }
</div>