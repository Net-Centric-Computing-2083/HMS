@using Microsoft.AspNetCore.Mvc.Rendering
@model MedicalHistory
@{ ViewData["Title"] = "Add Diagnosis Entry"; }
<h2>Add Diagnosis / Notes Entry</h2>
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="PatientID" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Doctor</label>
            <select asp-for="DoctorID" asp-items="@(new SelectList(ViewBag.Doctors, "DoctorID", "FullName"))" class="form-select"></select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Visit Date</label>
            <input asp-for="VisitDate" type="date" class="form-control" />
        </div>
        <div class="col-12">
            <label class="form-label">Diagnosis</label>
            <textarea asp-for="Diagnosis" class="form-control"></textarea>
        </div>
        <div class="col-12">
            <label class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-patientId="@Model.PatientID" class="btn btn-secondary">Cancel</a>
    </div>
</form>
