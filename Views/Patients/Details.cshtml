@model Patient
@{
    ViewData["Title"] = "Patient Details";
}
<h2>@Model.FullName</h2>
<dl class="row">
    <dt class="col-sm-3">Patient ID</dt><dd class="col-sm-9">@Model.PatientID</dd>
    <dt class="col-sm-3">Date of Birth</dt><dd class="col-sm-9">@Model.DateOfBirth.ToShortDateString()</dd>
    <dt class="col-sm-3">Gender</dt><dd class="col-sm-9">@Model.Gender</dd>
    <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.ContactNumber</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address</dd>
    <dt class="col-sm-3">Blood Group</dt><dd class="col-sm-9">@Model.BloodGroup</dd>
    <dt class="col-sm-3">Registered On</dt><dd class="col-sm-9">@Model.RegistrationDate.ToShortDateString()</dd>
</dl>
<a asp-controller="Appointments" asp-action="Index" asp-route-patientId="@Model.PatientID" class="btn btn-outline-primary btn-sm">Appointments</a>
<a asp-controller="MedicalHistory" asp-action="Index" asp-route-patientId="@Model.PatientID" class="btn btn-outline-primary btn-sm">Medical History</a>
<a asp-controller="Prescriptions" asp-action="Index" asp-route-patientId="@Model.PatientID" class="btn btn-outline-primary btn-sm">Prescriptions</a>
<a asp-controller="Bills" asp-action="Index" asp-route-patientId="@Model.PatientID" class="btn btn-outline-primary btn-sm">Bills</a>
<a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
