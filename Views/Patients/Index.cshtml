@model List<Patient>
@{
    ViewData["Title"] = "Patients";
}
<h2>Patients</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="term" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by ID, name, or contact number" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary">+ New Patient</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th><th>Name</th><th>Gender</th><th>Contact</th><th>Blood Group</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.PatientID</td>
            <td>@p.FullName</td>
            <td>@p.Gender</td>
            <td>@p.ContactNumber</td>
            <td>@p.BloodGroup</td>
            <td>
                <a asp-action="Details" asp-route-id="@p.PatientID" class="btn btn-sm btn-outline-primary">View</a>
                <a asp-action="Edit" asp-route-id="@p.PatientID" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Delete" asp-route-id="@p.PatientID" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
