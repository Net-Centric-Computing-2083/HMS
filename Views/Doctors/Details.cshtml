@model Doctor
@{ ViewData["Title"] = "Doctor Details"; }
<h2>@Model.FullName</h2>
<dl class="row">
    <dt class="col-sm-3">Doctor ID</dt><dd class="col-sm-9">@Model.DoctorID</dd>
    <dt class="col-sm-3">Specialization</dt><dd class="col-sm-9">@Model.Specialization</dd>
    <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.ContactNumber</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Available Days</dt><dd class="col-sm-9">@Model.AvailableDays</dd>
<dt class="col-sm-3">Consultation Fee</dt><dd class="col-sm-9">Rs. @Model.ConsultationFee.ToString("N2")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>
<a asp-controller="Appointments" asp-action="Index" asp-route-doctorId="@Model.DoctorID" class="btn btn-outline-primary btn-sm">View Appointments</a>
<a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
