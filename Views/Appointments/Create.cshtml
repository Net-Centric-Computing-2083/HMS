@using Microsoft.AspNetCore.Mvc.Rendering
@model Appointment
@{ ViewData["Title"] = "New Appointment"; }
<h2>New Appointment</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Patient</label>
            <select asp-for="PatientID" asp-items="@(new SelectList(ViewBag.Patients, "PatientID", "FullName"))" class="form-select">
                <option value="">-- select patient --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Doctor</label>
            <select asp-for="DoctorID" asp-items="@(new SelectList(ViewBag.Doctors, "DoctorID", "FullName"))" class="form-select">
                <option value="">-- select doctor --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Date</label>
            <input asp-for="AppointmentDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Time</label>
            <input asp-for="AppointmentTime" type="time" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Reason</label>
            <input asp-for="Reason" class="form-control" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Book Appointment</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
@section Scripts {
    @{ 
        // Needed for SelectList in the view above
    }
}
